    {
      "name": "List Pets Paginated and Sorted (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200 paginated Page response', function () {",
              "    pm.response.to.have.status(200);",
              "    var json = pm.response.json();",
              "    pm.expect(json.content).to.be.an('array');",
              "    pm.expect(json).to.have.property('totalElements');",
              "    pm.expect(json).to.have.property('totalPages');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/pets?page=0&size=5&sort=name,asc",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "pets"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "5" },
            { "key": "sort", "value": "name,asc" }
          ]
        }
      }
