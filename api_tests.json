{
  "info": {
    "name": "Week11 - Owen Ezekiel A. Anchola API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Pet - Validation Error (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400 with validation errors array', function () {",
              "    pm.response.to.have.status(400);",
              "    var json = pm.response.json();",
              "    pm.expect(json.errors).to.be.an('array').that.is.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"microchipNumber\": \"\",\n  \"name\": \"\",\n  \"species\": \"Dog\",\n  \"ownerId\": 0\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/pets",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "pets"]
        }
      }
    },
